generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum ModuleType {
  MINDSET
  BUSINESS
  TUNNEL
  OPTIMISATION
  ONBOARDING
}

enum QuestionStatus {
  PENDING
  IN_PROGRESS
  ANSWERED
}

enum NoteVisibility {
  CLIENT_VISIBLE
  TEAM_ONLY
}

enum AuditType {
  INITIAL
  MID
  FINAL
}

enum AuditStatus {
  DRAFT
  SUBMITTED
}

enum SessionType {
  GROUP
  INDIVIDUAL
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  firstName     String
  lastName      String
  role          Role      @default(CLIENT)
  avatarUrl        String?
  phone            String?
  ghlCalendarSlug  String?
  isActive         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations client
  clientProfile        ClientProfile?
  moduleProgresses     ModuleProgress[]
  dailyActions         DailyAction[]
  gratitudes           Gratitude[]
  weeklyVictories      WeeklyVictory[]
  questions            Question[]
  questionReplies      QuestionReply[]
  coachingNotes        CoachingNote[]
  auditResponses       AuditResponse[]
  auditComments        AuditSectionComment[]
  passwordResetTokens  PasswordResetToken[]
  accounts             Account[]

  // Relations coach
  assignedClients   CoachClientAssignment[] @relation("CoachAssignments")
  coachingSessions  CoachingSession[]       @relation("CoachSessions")

  // Relations partagées
  clientAssignments CoachClientAssignment[] @relation("ClientAssignments")
  clientSessions    CoachingSession[]       @relation("ClientSessions")

  // Formation
  lessonProgresses  LessonProgress[]
  clientDocuments   ClientDocument[]
}

model ClientProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Contexte initial
  currentRevenue    Float?
  targetRevenue     Float?
  currentSalary     Float?
  targetSalary      Float?
  objective6months  String?
  programStartDate  DateTime?
  programEndDate    DateTime?

  // Audit départ
  auditNotes        String?
  auditCompletedAt  DateTime?

  // Lien booking GHL individuel
  ghlBookingUrl     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CoachClientAssignment {
  id        String   @id @default(cuid())
  coachId   String
  clientId  String
  coach     User     @relation("CoachAssignments", fields: [coachId], references: [id])
  client    User     @relation("ClientAssignments", fields: [clientId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([coachId, clientId])
}

model Phase {
  id          String   @id @default(cuid())
  order       Int      @unique
  title       String
  description String?
  modules     Module[]
}

model Module {
  id           String      @id @default(cuid())
  phaseId      String
  phase        Phase       @relation(fields: [phaseId], references: [id])
  order        Int
  title        String
  description  String?
  type         ModuleType
  videoUrl     String?
  exerciseUrl  String?
  progresses   ModuleProgress[]

  @@unique([phaseId, order])
}

model ModuleProgress {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId          String
  module            Module    @relation(fields: [moduleId], references: [id])

  videoWatched      Boolean   @default(false)
  videoWatchedAt    DateTime?

  exerciseSubmitted Boolean   @default(false)
  submittedAt       DateTime?
  submissionNote    String?

  coachValidated    Boolean   @default(false)
  validatedAt       DateTime?
  coachComment      String?

  realImplementation Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@unique([userId, moduleId])
}

model DailyAction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  completed Boolean  @default(false)
  order     Int      @default(1)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Gratitude {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model WeeklyVictory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String
  weekStartDate DateTime
  createdAt     DateTime @default(now())
}

model CoachingSession {
  id           String      @id @default(cuid())
  coachId      String
  coach        User        @relation("CoachSessions", fields: [coachId], references: [id])
  clientId     String?
  client       User?       @relation("ClientSessions", fields: [clientId], references: [id])
  title        String
  type         SessionType
  scheduledAt  DateTime
  duration     Int?
  meetingUrl   String?
  firefliesUrl String?
  summary      String?     @db.Text
  decisions    String?     @db.Text
  notes        CoachingNote[]
  actions      SessionAction[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model SessionAction {
  id               String          @id @default(cuid())
  sessionId        String
  session          CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content          String
  completedByClient Boolean        @default(false)
  completedAt      DateTime?
  addedToDashboard Boolean         @default(false)
  createdAt        DateTime        @default(now())
}

model CoachingNote {
  id         String         @id @default(cuid())
  sessionId  String?
  session    CoachingSession? @relation(fields: [sessionId], references: [id])
  authorId   String
  author     User           @relation(fields: [authorId], references: [id])
  clientId   String
  content    String
  visibility NoteVisibility @default(CLIENT_VISIBLE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Question {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  content   String
  status    QuestionStatus @default(PENDING)
  replies   QuestionReply[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model QuestionReply {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())
}

model Inspiration {
  id        String   @id @default(cuid())
  quote     String
  author    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditResponse {
  id          String      @id @default(cuid())
  clientId    String
  client      User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        AuditType   @default(INITIAL)
  status      AuditStatus @default(DRAFT)
  responses   Json        @default("{}")
  submittedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  comments    AuditSectionComment[]

  @@unique([clientId, type])
}

model GhlCourse {
  id          String         @id @default(cuid())
  ghlId       String         @unique
  title       String
  description String?
  imageUrl    String?
  accessUrl   String?
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  syncedAt    DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  modules     CourseModule[]
}

enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model CourseModule {
  id              String          @id @default(cuid())
  courseId        String
  course          GhlCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  templateDriveId String?
  order           Int             @default(0)
  lessons         Lesson[]
  clientDocs      ClientDocument[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Lesson {
  id         String           @id @default(cuid())
  moduleId   String
  module     CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  order      Int              @default(0)
  progresses LessonProgress[]
  createdAt  DateTime         @default(now())
}

model LessonProgress {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status    LessonStatus @default(NOT_STARTED)
  updatedAt DateTime     @updatedAt

  @@unique([userId, lessonId])
}

model ClientDocument {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  driveFileId String
  driveUrl    String
  createdAt   DateTime     @default(now())

  @@unique([userId, moduleId])
}

model AuditSectionComment {
  id              String        @id @default(cuid())
  auditResponseId String
  auditResponse   AuditResponse @relation(fields: [auditResponseId], references: [id], onDelete: Cascade)
  coachId         String
  coach           User          @relation(fields: [coachId], references: [id])
  section         Int
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([auditResponseId, coachId, section])
}
